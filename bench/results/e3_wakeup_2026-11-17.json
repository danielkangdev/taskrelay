{
  "experiment": "E3 wake-up latency",
  "method": "Poisson arrivals at 5 jobs/s for 60s, bench(write) jobs, poll interval 1000 ms. Latency = started_at - created_at (database clock).",
  "environment": {
    "timestamp": "2026-11-17T19:20:18.687Z",
    "client": {
      "in_docker": true,
      "node": "v22.23.5",
