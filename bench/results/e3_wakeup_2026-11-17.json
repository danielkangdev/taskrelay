      "cpu_cores": 12,
      "mem_gb": 7.6
    },
    "postgres": {
      "version": "16.16 (Debian 16.16-1.pgdg13+1)",
      "in_docker": true,
      "container_cpu_limit": "max 100000",
      "settings": {
        "fsync": "on",
        "max_connections": "200",
        "max_wal_size": "1024 MB",
        "shared_buffers": "16384 8kB",
        "synchronous_commit": "on",
        "wal_level": "replica",
        "work_mem": "4096 kB"
      }
    },
    "bench_synchronous_commit": "on",
